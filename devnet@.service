[Unit]
Description=Cosmovisor for imuad node %I
After=network.target

[Service]
User=root
Group=root
EnvironmentFile=-/root/localnetV8/%I/start.env
ExecStart=/bin/bash -c "/usr/bin/cosmovisor --cosmovisor-config /root/localnetV8/%I/cosmovisor/config.toml run start --home /root/localnetV8/%I ${ADDITIONAL_OPTS}"
Restart=on-failure
LogRateLimitIntervalSec=0
LogRateLimitBurst=0

[Install]
WantedBy=default.target
